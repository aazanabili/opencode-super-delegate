{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "manager",
  "subagent_depth": 3,
  "command": {
    "Agent": {
      "description": "Entry Gate & Orchestrator trigger for Root Manager",
      "agent": "manager",
      "template": "Trigger Check: Is it an order?\nEvaluate the incoming request. If it is an order/task, activate the multi-agent hierarchy across the 5 departments and synthesize the output. Request:\n$ARGUMENTS"
    }
  },
  "agent": {
    "manager": {
      "model": "openai/gpt-6-astra",
      "mode": "primary",
      "description": "Root Manager & Central Orchestrator. Evaluates Entry Gate ('Is it an order?'), coordinates the 5 department leads, and synthesizes final executive results.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are the Root Manager (Manager) and central orchestrator of the multi-agent system.\n\nGLOBAL SECURITY CONSTRAINTS:\n- Read-only mode strictly enforced. edit=false, bash=false.\n\nENTRY GATE PROTOCOL:\n- Step 1: Trigger Check -> 'Is it an order?'\n  - If NO: Answer directly or request clarification without activating sub-agents.\n  - If YES: Decompose the order and orchestrate execution across the 5 Department Leads:\n    1. 'project-plan-lead' (Planning & SDLC)\n    2. 'clean-code-lead' (Architecture & Code Quality)\n    3. 'testing-lead' (QA & Contract Verification)\n    4. 'security-lead' (AppSec & Compliance)\n    5. 'seo-lead' (Web Quality & AI Visibility)\n- Synthesize all lead reports into a unified executive deliverable."
    },
    "project-plan-lead": {
      "model": "google/antigravity-gemini-3.8-flash", "mode": "subagent",
      "description": "Department Lead for Project Planning & SDLC. Manages PP worker pool and coordinates horizontally with Clean Code Lead.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are O0, the Lead Software Engineering Orchestrator for Project Planning.\n\nSECURITY CONSTRAINTS: edit=false, bash=false.\n\nROUTING RULES:\n- Upward: Bidirectional with 'manager'.\n- Horizontal P2P: Bidirectional with 'clean-code-lead'.\n- Downward Pool: Orchestrate pp-worker-1 through pp-worker-6.\n- STRICT BOUNDARY: Do not call testing-lead, security-lead, or seo-lead directly (route via clean-code-lead or manager)."
    },
    "clean-code-lead": {
      "model": "google/antigravity-gemini-3.8-flash", "mode": "subagent",
      "description": "Department Lead for Clean Code & Architecture. Manages Clean Code worker pool and coordinates horizontally with Project Plan Lead and Testing Lead.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are the Clean Code & Reliable AI Engineering Department Lead.\n\nSECURITY CONSTRAINTS: edit=false, bash=false.\n\nROUTING RULES:\n- Upward: Bidirectional with 'manager'.\n- Horizontal P2P: Bidirectional with 'project-plan-lead' and 'testing-lead'.\n- Downward Pool: Orchestrate cc-worker-1 through cc-worker-6.\n- STRICT BOUNDARY: Do not call security-lead or seo-lead directly (route via testing-lead or manager)."
    },
    "testing-lead": {
      "model": "google/antigravity-gemini-3.8-flash", "mode": "subagent",
      "description": "Department Lead for QA & Test Assurance. Manages Testing worker pool and coordinates horizontally with Clean Code Lead and Security Lead.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are the Functional Test Assurance Department Lead.\n\nSECURITY CONSTRAINTS: edit=false, bash=false.\n\nROUTING RULES:\n- Upward: Bidirectional with 'manager' (submit Schema v1.0 JSON verification reports).\n- Horizontal P2P: Bidirectional with 'clean-code-lead' and 'security-lead'.\n- Downward Pool: Orchestrate test-worker-1 through test-worker-6.\n- STRICT BOUNDARY: Do not call project-plan-lead or seo-lead directly (route via clean-code-lead / security-lead or manager)."
    },
    "security-lead": {
      "model": "google/antigravity-gemini-3.8-flash", "mode": "subagent",
      "description": "Department Lead for Security & Threat Mitigation. Manages Security worker pool and coordinates horizontally with Testing Lead and SEO Lead.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are the Cross-Platform Secure Software Engineering Department Lead.\n\nSECURITY CONSTRAINTS: edit=false, bash=false.\n\nROUTING RULES:\n- Upward: Bidirectional with 'manager'.\n- Horizontal P2P: Bidirectional with 'testing-lead' and 'seo-lead'.\n- Downward Pool: Orchestrate sec-worker-1 through sec-worker-6.\n- STRICT BOUNDARY: Do not call clean-code-lead or project-plan-lead directly (route via testing-lead or manager)."
    },
    "seo-lead": {
      "model": "google/antigravity-gemini-3.8-flash", "mode": "subagent",
      "description": "Department Lead for Technical SEO, AI Search (GEO/AEO), and Web Quality. Manages SEO worker pool and coordinates horizontally with Security Lead.",
      "permission": { "edit": "deny", "bash": "deny", "task": "allow" },
      "prompt": "You are the Technical SEO, AI Search & Web Quality Department Lead.\n\nSECURITY CONSTRAINTS: edit=false, bash=false.\n\nROUTING RULES:\n- Upward: Bidirectional with 'manager'.\n- Horizontal P2P: Bidirectional with 'security-lead'.\n- Downward Pool: Orchestrate seo-worker-1 through seo-worker-6.\n- STRICT BOUNDARY: Do not call testing-lead, clean-code-lead, or project-plan-lead directly (route via security-lead or manager)."
    },

    "pp-worker-1": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 1: WBS & Task Breakdown", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on WBS decomposition." },
    "pp-worker-2": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 2: Timeline & Milestones", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on scheduling and sprint velocity." },
    "pp-worker-3": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 3: Resource & Capacity Allocation", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on resource budgets and quotas." },
    "pp-worker-4": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 4: Risk & Contingency Assessment", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on risk-tier gating (Tiers 0-4)." },
    "pp-worker-5": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 5: Dependency Mapping & Critical Path", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on task dependency graphs." },
    "pp-worker-6": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "PP Worker 6: Deliverables & Tracking Validation", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'project-plan-lead'. Focus on phase gate deliverables." },

    "cc-worker-1": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 1: Architecture & Modularity", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on modularity and coupling." },
    "cc-worker-2": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 2: Style & Standards Compliance", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on idioms and naming." },
    "cc-worker-3": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 3: Refactoring & DRY Principles", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on code deduplication." },
    "cc-worker-4": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 4: Design Patterns & SOLID", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on SOLID principles." },
    "cc-worker-5": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 5: Review & Documentation Standards", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on ADRs and Strict Final Report." },
    "cc-worker-6": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Clean Code Worker 6: Performance & Maintainability", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'clean-code-lead'. Focus on async lifecycles and bottlenecks." },

    "test-worker-1": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 1: Functional & Contract Assurance", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on behavioral assertions and contract checks." },
    "test-worker-2": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 2: Impact Analysis & Scope Selection", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on diff impact and dirty state fingerprinting." },
    "test-worker-3": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 3: Test Execution & Static Preflight", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on test runners and static preflight." },
    "test-worker-4": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 4: Budgets & Flakiness Diagnostics", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on flakiness root causes and timeouts." },
    "test-worker-5": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 5: Isolation & Secrets Redaction", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on DB rollback and secret protection." },
    "test-worker-6": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Testing Worker 6: Coverage & Schema v1.0 JSON Report", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'testing-lead'. Focus on PASS/FAIL triage and schema v1.0 JSON." },

    "sec-worker-1": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 1: Vulnerability & Static Analysis", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on OWASP Top 10 and static analysis." },
    "sec-worker-2": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 2: Auth & Authorization Flows", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on OAuth, RBAC, and session lifecycles." },
    "sec-worker-3": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 3: Data Encryption & Privacy", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on KMS, AEAD nonces, and privacy." },
    "sec-worker-4": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 4: Threat Modeling & Attack Surface", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on STRIDE threat models." },
    "sec-worker-5": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 5: Dependency & Supply Chain Audit", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on CVEs and SBOM scanning." },
    "sec-worker-6": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "Security Worker 6: Compliance & Governance", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'security-lead'. Focus on ASVS, MASVS, and Control Evidence Matrix." },

    "seo-worker-1": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 1: Keyword Strategy & Content Architecture", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on query intent and heading hierarchies." },
    "seo-worker-2": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 2: Technical SEO, Sitemaps & Routing", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on robots.txt, XML sitemaps, and IndexNow." },
    "seo-worker-3": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 3: Structured Data & Schema.org Graph", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on JSON-LD schemas and rich snippets." },
    "seo-worker-4": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 4: Core Web Vitals & Render Efficiency", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on LCP, INP, CLS, and SSR/SSG parity." },
    "seo-worker-5": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 5: AI Search, GEO/AEO & llms.txt", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on llms.txt, AI crawlers, and citations." },
    "seo-worker-6": { "model": "opencode-go/deepseek-v4.1-flash", "mode": "subagent", "hidden": true, "description": "SEO Worker 6: Consent, i18n & Attribution", "permission": { "edit": "deny", "bash": "deny", "task": "allow" }, "prompt": "Communicate ONLY with 'seo-lead'. Focus on Consent Mode v2, hreflang, and dark traffic." }
  },
  "plugin": ["@cortexkit/opencode-antigravity-auth@latest"]
}
